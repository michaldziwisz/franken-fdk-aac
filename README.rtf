{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 {\f1 --ath-scale <n>}\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 1..~4096 (Q8)\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 256\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 Masking threshold scale in Q8 (256 = x1.0). {\f1 >256} raises the thresholds (more noise, fewer bits per band), {\f1 <256} lowers them (cleaner, more bits). Works in FDK's ld64 domain as an additive log2 offset.\par}
\cell}
}
\intbl\row}
{
\trowd \trgaph120
\cellx2160\cellx4320\cellx6480\cellx8640
\trkeep\intbl
