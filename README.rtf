\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 -1 (100 = x1.00)\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 Scales the master transient threshold. {\b The most effective knob in this group} - see the pre-echo measurement below.\par}
\cell}
}
\intbl\row}
{
\trowd \trgaph120
\cellx2160\cellx4320\cellx6480\cellx8640
\trkeep\intbl
{
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 {\f1 --sbr-tran-split <n>}\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 1..10000\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 -1 (100 = x1.00)\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 Scales the envelope-split threshold: how readily a frame with no detected transient is still split into two envelopes. Lower = split more often (finer time resolution, costs bits).\par}
\cell}
}
\intbl\row}
{
\trowd \trgaph120
\cellx2160\cellx4320\cellx6480\cellx8640
\trkeep\intbl
{
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 {\f1 --sbr-tran-quiet <n>}\par}
