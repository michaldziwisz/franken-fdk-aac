\intbl\row}
{\pard \ql \f0 \sa180 \li0 \fi0 \par}
{\pard \ql \f0 \sa180 \li0 \fi0 The profile (AOT) is picked AUTOMATICALLY from bitrate and channel count, the same way {\f1 odr-audioenc} does it \u8212- you normally don't set {\f1 -p}:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab stereo \u8804 ?48 kbps (subchannel \u8804 ?6) \u8594 ? {\b HE-AAC v2} (PS),\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab mono \u8804 ?64k or stereo \u8804 ?80k \u8594 ? {\b HE-AAC} (SBR),\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab higher \u8594 ? {\b AAC-LC}.\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 You can still force the profile with {\f1 -p} ({\f1 2}=LC, {\f1 5}=HE-AAC, {\f1 29}=HE-AAC v2) if you know what you want.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 {\f1 --dab-label <text>}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 A static {\b DLS} (Dynamic Label Segment) carried as X-PAD inside the super frame; DAB+ receivers show it as the station name / title. Up to ~48 characters (three segments in one PAD). "Static" means one fixed string for the whole file \u8212- time-varying labels and MOT slideshow (the {\f1 ODR-PadEnc} model) are planned for later. Without {\f1 --dab} the label is ignored.\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 Examples\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 # 48k/32k stereo, ~96k \u8594 ? auto AAC-LC:\line
fdkaac --dab -b 96 -o out.dabp input.wav\line
\line
# \u8594 ? auto HE-AAC (SBR):\line
fdkaac --dab -b 64 -o out.dabp input.wav\line
\line
# \u8594 ? auto HE-AAC v2 (PS):\line
fdkaac --dab -b 32 -o out.dabp input.wav\line
\line
# with a station label:\line
fdkaac --dab -b 96 --dab-label "Radio DHT" -o out.dabp input.wav\line
\line
# broadcast chain:\line
# out.dabp \u8594 ? odr-dabmux \u8594 ? ETI \u8594 ? transmitter / decoder\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Note: without {\f1 --dab} the encoder behaves exactly as before \u8212- zero impact, bit-identical to stock. Verified: the streams decode with an independent faad2 decoder (dablin), the DLS label is readable, and the LC output is bit-identical to the reference {\f1 odr-audioenc}. Nine combinations (48/32 kHz \u215 ? mono/stereo \u215 ? the three profiles) were tested, each independently decodable.\par}
{\pard \qc \f0 \sa180 \li0 \fi0 \emdash\emdash\emdash\emdash\emdash\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 Examples\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 # Starting point \u8212- what the encoder set:\line
fdkaac-franken-x64.exe -p 29 -b 48000 --verbose -o out.m4a in.wav\line
\line
# Quasi-constrained VBR ~128k (safe preset):\line
fdkaac-franken-x64.exe -p 2 -b 128000 --peak-bitrate 160000 --vbr-reservoir 6000 -o out.m4a in.wav\line
\line
# Aggressive intensity stereo at 64k:\line
fdkaac-franken-x64.exe -p 2 -b 64000 --is 1 --is-aggression 70 -o out.m4a in.wav\line
\line
# Force PNS at 24k (otherwise the FDK gate disables it):\line
fdkaac-franken-x64.exe -p 2 -b 24000 --pns 1 --force-pns -o out.m4a in.wav\line
\line
# Audiophile full 40 kHz band from a 96 kHz input:\line
fdkaac-franken-x64.exe -p 2 -b 320000 --uncap-bandwidth --core-cutoff 40000 -o out.m4a in96k.wav\line
\line
# MS on the 5 highest bands + shallower holes (not the lowest):\line
fdkaac-franken-x64.exe -p 2 -b 128000 --msbands-lo 44 --msbands-hi 48 --ms-precision 448 -o out.m4a in.wav\line
\line
# Extremely low HE-AAC v2: 8000 bps stereo 48 kHz:\line
fdkaac-franken-x64.exe -p 29 -b 8000 --unlock-bitrate -o out.m4a in48k.wav\line
\line
# SBR: full stereo separation LR + forced inverse filtering:\line
fdkaac-franken-x64.exe -p 5 -b 96000 --sbr-stereo-mode 1 --sbr-invf 2 -o out.m4a in.wav\line
\line
# Your case: 7.5 kHz of core under HE-AAC v2 48k:\line
fdkaac-franken-x64.exe -p 29 -b 48000 --core-cutoff 7500 -o out.m4a in.wav\line
\line
# Completely independent stereo (no MS/IS) on LC 128k:\line
fdkaac-franken-x64.exe -p 2 -b 128000 --msmask 0 --is 0 -o out.m4a in.wav\line
\line
# MS only on the 6 lower bands:\line
fdkaac-franken-x64.exe -p 2 -b 96000 --msmask 1 --msbands 6 -o out.m4a in.wav\line
\line
# Only short blocks + limited TNS:\line
# Only long blocks (bias) + limited TNS:\line
fdkaac-franken-x64.exe -p 2 -b 96000 --block-bias 0 --tns-order 2 -o out.m4a in.wav\line
\line
# More aggressive masking (thresholds x2) + earlier PNS:\line
fdkaac-franken-x64.exe -p 2 -b 80000 --ath-scale 512 --pns 1 --pns-start 4000 -o out.m4a in.wav\line
\line
# Denser SBR noise description + more precise amplitude:\line
fdkaac-franken-x64.exe -p 5 -b 64000 --sbr-noise-bands 5 --sbr-amp-res 0 -o out.m4a in.wav\line
\line
# HE-AAC v2 with PS disabled (flattened stereo):\line
fdkaac-franken-x64.exe -p 29 -b 32000 --ps 0 -o out.m4a in.wav\par}
