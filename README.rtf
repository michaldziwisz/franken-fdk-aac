\intbl\row}
{
\trowd \trgaph120
\cellx2160\cellx4320\cellx6480\cellx8640
\trkeep\intbl
{
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 {\f1 --sbr-mh-decay-diff <n>}\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 1..10000\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 -1 (100)\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 Same, for the difference guide vector.\par}
\cell}
}
\intbl\row}
{
\trowd \trgaph120
\cellx2160\cellx4320\cellx6480\cellx8640
\trkeep\intbl
