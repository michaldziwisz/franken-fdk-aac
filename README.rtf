{
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 {\f1 --ms-precision <n>}\par}
\cell}
{{\pard\intbl \ql \f0 \sa0 \li0 \fi0 256..no limit (Q8)\par}
\cell}
